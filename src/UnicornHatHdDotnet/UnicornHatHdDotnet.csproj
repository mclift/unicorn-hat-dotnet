<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Mclift.UnicornHatHdDotnet</PackageId>
    <AssemblyName>Mclift.UnicornHatHdDotnet</AssemblyName>
    <RootNamespace>Mclift.UnicornHatHdDotnet</RootNamespace>
    <Title></Title>
    <Authors>mclift</Authors>
    <Company />
    <Description>A .NET Library to drive the Pimoroni Unicorn HAT HD on the Raspberry Pi.</Description>
    <PackageTags>unicorn-hat;unicornhathd;raspberry-pi;iot;led;spi</PackageTags>
    <PackageProjectUrl>https://github.com/mclift/unicorn-hat-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mclift/unicorn-hat-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Only System.Device.Spi is used; Iot.Device.Bindings pulled in vulnerable transitive packages. -->
    <PackageReference Include="System.Device.Gpio" Version="4.2.0" />
  </ItemGroup>

</Project>
